{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CubeOSNodeProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "arch", "os_family", "capabilities"],
  "properties": {
    "node_id": { "type": "string", "description": "Random opaque id; not a person name" },
    "arch": { "type": "string", "enum": ["x86_64", "aarch64", "armv7", "riscv64"] },
    "os_family": { "type": "string", "enum": ["linux", "android"] },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "enum": ["peer", "shell", "robot", "vr_view", "display", "audio_out"] }
    },
    "purpose": { "type": "string", "default": "unassigned" },
    "integrity": { "type": "string", "enum": ["ok", "deny", "unknown"] }
  }
}
