# Agent runtime (pid, live logs stay local; committed structure only)
.agents/manager/manager.pid
.agents/manager/heartbeat.json
.agents/logs/*.log
.agents/watcher/last_scan.json

# Quarantine holding area (contents not committed)
.agents/quarantine/*
!.agents/quarantine/.gitkeep
